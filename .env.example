# ---- Required ----
# MongoDB Atlas connection string (holds the WhatsApp session and all bot data)
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority
# Your WhatsApp number with country code, digits only (the bot owner)
OWNER_NUMBER=255700000000
# Same SESSION_ID you used when running the scanner
SESSION_ID=darken

# ---- DELOOP (the commands repo). Use ONE of the two options ----
# Option A (Render): private GitHub repo + a read-only fine-grained token for that repo only
DELOOP_REPO=your-github-username/DELOOP
DELOOP_TOKEN=github_pat_xxxxxxxx
DELOOP_BRANCH=main
# Option B (local testing): path to a local copy of DELOOP, no GitHub needed
# DELOOP_PATH=../DELOOP

# ---- Optional ----
BOT_NAME=DARKEN
OWNER_NAME=Owner
PREFIX=!
TIMEZONE=Africa/Dar_es_Salaam
PACK_NAME=DARKEN
AUTHOR=DARKEN
MONGO_DB=darken
PAIR_URL=
TELEGRAM_BOT_TOKEN=
LOG_LEVEL=silent
